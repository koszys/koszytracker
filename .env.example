# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/wishtracker
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me_to_a_strong_password

# pgAdmin
PGADMIN_PASSWORD=change_me_to_a_strong_password

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# JWT
JWT_SECRET=generate_a_random_256_bit_key

# Payload CMS
PAYLOAD_SECRET=generate_a_random_256_bit_key
DATABASE_URL=postgresql://postgres:change_me_to_a_strong_password@localhost:5433/wishtracker
NEXT_PUBLIC_PAYLOAD_API_URL=http://localhost:3000/api

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# OAuth redirect URL (frontend callback)
OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Cloudflare R2 (file storage via S3-compatible API)
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
