# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/wishtracker
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me_to_a_strong_password

# pgAdmin
PGADMIN_PASSWORD=change_me_to_a_strong_password

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# JWT
JWT_SECRET=generate_a_random_256_bit_key

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# OAuth redirect URL (frontend callback)
OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback
